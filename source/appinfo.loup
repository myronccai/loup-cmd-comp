@mode(host.dual)

# Application identity for comp: name, version, summary and the exit
# statuses (comp.exe's ERRORLEVELs). Keep APP_NAME and APP_VERSION in step
# with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/comp by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "comp";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Compare two files or sets of files byte by byte (a Loup recreation of the Windows comp command).";

# Exit statuses returned by main(), as comp.exe sets ERRORLEVEL.
pub const EXIT_SAME: int = 0;       # every pair compared equal
pub const EXIT_DIFFERENT: int = 1;  # some pair differs (content or size)
pub const EXIT_ERROR: int = 2;      # a file could not be found or opened, or bad arguments
