@mode(host.dual)

# Command-line parsing for comp, following the Windows switch convention in
# win/switches.loup:
#
#   COMP [data1] [data2] [/D] [/A] [/L] [/N=number] [/C] [/OFF[LINE]] [/M]
#
# Switches are case-insensitive and start with `/` or `-`; a `/X` that comp
# does not declare is a file name. `--` ends switch parsing.
#
# Runtime: host.dual. Compiled into the native binary build/comp by `make
# build`; `loup run source/main.loup` interprets the same code.

from win.switches import (SwitchArgs, SwitchSpec, flag, optional_value, parse_switches,
    has_switch, last_switch, parse_int_value, switch_error_message);

# How differing bytes are shown.
pub const SHOW_HEX: int = 0;      # default: `file1 = 61`
pub const SHOW_DECIMAL: int = 1;  # /D: `file1 = 97`
pub const SHOW_ASCII: int = 2;    # /A: `file1 = a`

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub show: int;           # SHOW_HEX, SHOW_DECIMAL or SHOW_ASCII
    pub by_line: bool;       # /L: report line numbers instead of offsets
    pub max_lines: int;      # /N=number, or -1 for the whole file
    pub ignore_case: bool;   # /C
    pub operands: list[string];
}

# The switches comp declares. /M and /OFF[LINE] are accepted and change
# nothing: comp never prompts for more files here, and Linux files have no
# offline attribute.
pub func comp_switches(): list[SwitchSpec] {
    return [flag("D"), flag("A"), flag("L"), optional_value("N", "0123456789"), flag("C"),
        flag("OFFLINE"), flag("OFF"), flag("M")];
}

# comp's message for a switch or argument it cannot use.
pub func msg_comp_invalid_switch(text: string): string {
    return "Invalid switch - " + text;
}

# The display mode: the last of /A and /D wins; hexadecimal without either.
func show_mode(parsed: SwitchArgs): int {
    var show = SHOW_HEX;
    for (sw in parsed.switches) {
        if (sw.name == "A") {
            show = SHOW_ASCII;
        } else if (sw.name == "D") {
            show = SHOW_DECIMAL;
        }
    }
    return show;
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, comp_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(switch_error_message(e));
        },
    };

    var max_lines = -1;
    if (!parsed.help and has_switch(parsed, "N")) {
        let sw = last_switch(parsed, "N").unwrap();
        let n = parse_int_value(sw.value) ?? -1;
        if (!sw.has_value or n < 1 or sw.value.startsWith("+") or sw.value.startsWith("-")) {
            return Err(msg_comp_invalid_switch(sw.token));
        }
        max_lines = n;
    }
    if (!parsed.help and parsed.operands.len() > 2) {
        return Err(msg_comp_invalid_switch(parsed.operands[2]));
    }

    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        show = show_mode(parsed),
        by_line = has_switch(parsed, "L"),
        max_lines = max_lines,
        ignore_case = has_switch(parsed, "C"),
        operands = parsed.operands,
    ));
}
