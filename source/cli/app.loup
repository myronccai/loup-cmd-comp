@mode(host.dual)

from appinfo import (EXIT_SAME, EXIT_ERROR);
from cli.args import (Options, parse_args);
from cli.prompt import (complete_args);
from cli.usage import (usage, version_line);
from commands.comp import (run_comp);

# Parses argv, runs comp and returns the exit status (comp's ERRORLEVEL).
pub func run(argv: list[string]): int {
    var opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_ERROR;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_SAME;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_SAME;
    }

    if (opts.operands.len() < 2) {
        # Ask for the missing names (and more switches) on standard input.
        let plan = complete_args(argv, opts.operands.len(), readText("/dev/stdin"));
        for (p in plan.prompts) {
            println(p);
        }
        if (!plan.complete) {
            return EXIT_ERROR;
        }
        opts = match parse_args(plan.argv) {
            Ok(parsed) => parsed,
            Err(msg) => {
                printErr(msg);
                return EXIT_ERROR;
            },
        };
    }

    try {
        return run_comp(opts);
    } catch (Exception as e) {
        printErr(e.message);
        return EXIT_ERROR;
    }
}
